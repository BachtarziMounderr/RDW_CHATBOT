TELEGRAM_BOT_TOKEN=
BOT_MODE=private_qa
# polling en local ; webhook sur Render ou un autre hébergeur HTTPS.
TELEGRAM_TRANSPORT=polling
WEBHOOK_PUBLIC_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
# private : seuls les comptes autorisés peuvent discuter ; public : tous les comptes Telegram.
TELEGRAM_ACCESS_MODE=private
TELEGRAM_ALLOWED_USER_IDS=
# Le propriétaire 1953680558 doit être ajouté ici et dans TELEGRAM_ALLOWED_USER_IDS sur l'hébergeur.
RDW_ADMIN_USER_IDS=
# Utilisez la chaîne Neon « pooled connection » pour le service Render.
DATABASE_URL=
DASHBOARD_ENABLED=true
# L'accès reste local car le dashboard contient des coordonnées personnelles.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Obligatoires uniquement si DASHBOARD_HOST=0.0.0.0 (hébergement cloud).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
PRIVATE_CHANNEL_PRICE_DZD=1000
# Ancien contact conservé comme support. Les reçus sont désormais envoyés directement au bot.
PAYMENT_PROOF_TELEGRAM=0541501832
# À renseigner avec les coordonnées exactes fournies par RDW. Ne rien inventer.
BARIDIMOB_PAYMENT_DETAILS=
CCP_PAYMENT_DETAILS=
# Nom complet officiel du titulaire du compte CCP, affiché avec les coordonnées CCP.
CCP_ACCOUNT_HOLDER_NAME=
# Identifiant du canal Telegram privé, par exemple -1001234567890.
# Le bot doit être administrateur du canal avec le droit de créer des liens d'invitation.
VIP_CHANNEL_ID=
AI_PROVIDER=groq
AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Ancien adaptateur conservé, inactif lorsque AI_PROVIDER=groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MAX_CALLS_PER_USER_DAY=400
AI_MAX_CALLS_PER_DAY=800
AI_MAX_INPUT_CHARS=7000
DEBUG_SOURCE_LABELS=false
AI_MAX_OUTPUT_TOKENS=240
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1
AI_QUOTA_COOLDOWN_SECONDS=120
