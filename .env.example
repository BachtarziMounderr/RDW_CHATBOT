TELEGRAM_BOT_TOKEN=
BOT_MODE=private_qa
# polling en local ; webhook sur Koyeb.
TELEGRAM_TRANSPORT=polling
WEBHOOK_PUBLIC_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
# private : seuls les comptes autorisés peuvent discuter ; public : tous les comptes Telegram.
TELEGRAM_ACCESS_MODE=private
TELEGRAM_ALLOWED_USER_IDS=
# Le propriétaire 1953680558 doit être ajouté ici et dans TELEGRAM_ALLOWED_USER_IDS sur Koyeb.
RDW_ADMIN_USER_IDS=
# Utilisez la chaîne Neon « pooled connection » pour le service Koyeb.
DATABASE_URL=
DASHBOARD_ENABLED=true
# L'accès reste local car le dashboard contient des coordonnées personnelles.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Obligatoires uniquement si DASHBOARD_HOST=0.0.0.0 (hébergement Koyeb).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
CONSULTATION_PRICE_DZD=2000
PRIVATE_CHANNEL_PRICE_DZD=500
AI_PROVIDER=groq
AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Ancien adaptateur conservé, inactif lorsque AI_PROVIDER=groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MAX_CALLS_PER_USER_DAY=400
AI_MAX_CALLS_PER_DAY=800
AI_MAX_INPUT_CHARS=7000
DEBUG_SOURCE_LABELS=false
AI_MAX_OUTPUT_TOKENS=240
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1
AI_QUOTA_COOLDOWN_SECONDS=120
